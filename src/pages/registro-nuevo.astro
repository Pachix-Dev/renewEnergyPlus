---
import i18next, { changeLanguage, t } from "i18next";
import LayoutRegister from "../layouts/LayoutRegister.astro";
import { sponsors } from "../data/constanst_logos.js";
import MarqueeSponsors from "../components/register/MarqueeSponsors.astro";
import { RegisterForm } from "../components/register/RegisterForm.jsx";

changeLanguage("es");

const registerTranslations = t("register", { returnObjects: true });
const currentLanguage = i18next.language;
---

<LayoutRegister title="RE+ MEXICO REGISTRO AL EVENTO">
  <main class="py-5 w-full max-w-screen-xl container mx-auto px-4">
    <section class="mx-auto relative">
      <h1 class="mt-5 text-2xl lg:text-5xl text-center uppercase italic sub-title">
        {t("register.title")} <br />
        <p class="title-register uppercase font-extrabold">RE+ MEXICO 2027</p>
      </h1>

      <!-- Carrusel de sponsors -->
      <!-- <MarqueeSponsors partners={sponsors} isLeftToRight/> -->
      
      <RegisterForm
        translates={registerTranslations}
        currentLanguage={currentLanguage}
        client:only="react"
      />
    </section>
  </main>
</LayoutRegister>

<style>
  body {
    background-color: white;
    color: black;
  }

  @font-face {
    font-family: 'Montserrat-Italic';
    src: url('/fonts/Montserrat-Italic-VariableFont_wght.ttf') format('truetype');
  }
  @font-face {
    font-family: 'Montserrat-BlackItalic';
    src: url('/fonts/Montserrat/Montserrat-ExtraBold.ttf') format('truetype');
  }

  .sub-title {
    font-family: 'Montserrat-Italic', sans-serif;
  }

  .title-register{
    font-family: 'Montserrat-BlackItalic', sans-serif;
  }

</style>
