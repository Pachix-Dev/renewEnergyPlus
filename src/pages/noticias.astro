---
import i18next, { changeLanguage } from "i18next";
import Layout from "../layouts/Layout.astro";
import GridArticles from "../components/infoArticles/GridArticles.astro";
import SubNoticeComp from "../components/infoArticles/SubNoticeComp.astro";

changeLanguage("es");

const currentLanguage = i18next.language;
---

<Layout title="RE+ MEXICO | Noticias">
  <div class="bg-white">
    <header class="border-b border-gray-200 bg-[#f7f7fa]">
      <div class="container mx-auto px-6 py-2 sm:py-12 md:px-12 md:py-16 lg:px-20">
        <div
          class="max-w-5xl"
          data-aos="fade-up"
          data-aos-duration="800"
          data-aos-anchor-placement="top-center"
        >
          <div class="mb-5 flex items-center gap-3">
            <span class="h-10 w-1 bg-[#3333ff]"></span>
            <h1
            class="max-w-4xl text-3xl font-extrabold leading-tight text-[#3333ff] md:text-5xl"
          >
            {currentLanguage === "es" ? "Noticias, artículos y comunicados" : "News, articles and press releases"}
          </h1>
          </div>
          
          <p class="mt-4 max-w-4xl leading-relaxed text-gray-700 text-sm md:text-lg">
            {currentLanguage === "es"
              ? "Mantente al día con las novedades de RE+ MEXICO y los temas más relevantes para la industria energética."
              : "Stay up to date with the latest news from RE+ MEXICO and the most relevant topics for the energy industry."}
          </p>
        </div>
      </div>
    </header>

    <div class="container mx-auto px-4 md:px-12 lg:px-20">
      <main
        class="mx-auto mb-16 grid w-full max-w-7xl grid-cols-[minmax(0,1fr)_88px] gap-3 sm:grid-cols-[minmax(0,1fr)_140px] sm:gap-5 md:grid-cols-[minmax(0,1fr)_180px] lg:grid-cols-[minmax(0,1fr)_200px] lg:gap-8"
      >
        <section class="min-w-0">
          <GridArticles />
        </section>

        <aside class="sticky top-20 self-start py-8 md:top-24 md:py-10">
          <SubNoticeComp />
        </aside>

        <footer class="col-span-2 border-t border-gray-200 py-6">
          <p class="text-sm text-gray-600">
            {currentLanguage === "es"
              ? "Sigue nuestras publicaciones para conocer las novedades más recientes."
              : "Follow our posts to stay updated with the latest news."}
          </p>
        </footer>
      </main>
    </div>
  </div>
</Layout>
