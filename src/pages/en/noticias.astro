---
import i18next, { changeLanguage } from "i18next";
import Layout from "../../layouts/Layout.astro";
import GridArticles from "../../components/infoArticles/GridArticles.astro";
import SubNoticeComp from "../../components/infoArticles/SubNoticeComp.astro";

changeLanguage("en");

const currentLanguage = i18next.language;
---

<Layout title="RE+ MEXICO | Noticias">
  <div class="bg-white">
    <header class="border-b border-gray-200 bg-[#f7f7fa]">
      <div class="container mx-auto px-6 py-12 md:px-12 md:py-16 lg:px-20">
        <div
          class="max-w-5xl"
          data-aos="fade-up"
          data-aos-duration="800"
          data-aos-anchor-placement="top-center"
        >
          <div class="mb-5 flex items-center gap-3">
            <span class="h-10 w-1 bg-[#3333ff]"></span>
            <h1
            class="max-w-4xl text-3xl font-extrabold leading-tight text-[#3333ff] md:text-5xl"
          >
            {currentLanguage === "es" ? "RE+ Noticias" : "RE+ News"}
          </h1>
          </div>
          
          <p class="mt-4 max-w-4xl text-base leading-relaxed text-gray-700 md:text-lg">
            {currentLanguage === "es"
              ? "Las últimas noticias y novedades sobre la industria de energías renovables, innovación tecnológica y sostenibilidad. Mantente informado sobre los avances, eventos y tendencias que están dando forma al futuro de la energía."
              : "The latest news and updates on the renewable energy industry, technological innovation, and sustainability. Stay informed about the advancements, events, and trends shaping the future of energy."}
          </p>
        </div>
      </div>
    </header>

    <div class="container mx-auto px-6 md:px-12 lg:px-20">
      <main
        class="mx-auto mb-16 grid w-full max-w-7xl gap-8 lg:grid-cols-[minmax(0,1fr)_200px]"
      >
        <section class="min-w-0">
          <GridArticles />
        </section>

        <aside class="py-8 md:py-10 lg:sticky lg:top-24 lg:self-start">
          <SubNoticeComp />
        </aside>

        <footer class="border-t border-gray-200 py-6 lg:col-span-2">
          <p class="text-sm text-gray-600">
            {currentLanguage === "es"
              ? "Sigue nuestras publicaciones para conocer las novedades más recientes."
              : "Follow our posts to stay updated with the latest news."}
          </p>
        </footer>
      </main>
    </div>
  </div>
</Layout>
