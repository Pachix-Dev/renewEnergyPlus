---
import i18next, { changeLanguage, t } from "i18next";
import Layout from "../../layouts/Layout.astro";
import RegistrationConfirmation from "../../components/register/RegistrationConfirmation.astro";
import { Redirect } from "../../components/shared/Redirect.jsx";

changeLanguage("en");

const currentLanguage = i18next.language;
const base = currentLanguage === "es" ? "" : `/${currentLanguage}`;
---

<Layout title={t("thanks_page.registration.meta_title") ?? ""}>
  <Redirect client:only="react" />
  <RegistrationConfirmation base={base} />
</Layout>
