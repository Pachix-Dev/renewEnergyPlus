---
import i18next, { t } from "i18next";
---

<section
  class="w-full bg-white text-black py-4 md:py-6 lg:py-10 px-4"
>

  <div
    class="max-w-5xl mx-auto text-center flex flex-col items-center"
    data-aos="fade-up"
    data-aos-duration="1000"
  >

    <h1
      class="text-4xl sm:text-5xl lg:text-6xl font-black uppercase leading-tight"
    >
      {t("ambassadors.title")}
    </h1>


    <p
      class="mt-1 sm:mt-2 text-lg sm:text-xl lg:text-2xl max-w-3xl font-medium text-[#3333FF]"
    >
      {t("ambassadors.subtitle")}
    </p>

  </div>

</section>