---
import i18next, { t } from "i18next";

const { ambassador } = Astro.props;

const currentLanguage = i18next.language;
---

<article
  class="group w-full

  h-[120px] md:h-[180px] lg:h-[250px]

  rounded-[18px] md:rounded-[25px] lg:rounded-[30px]

  border border-gray-200 bg-white

  p-2 md:p-3 lg:p-6

  flex items-center

  gap-2 md:gap-5 lg:gap-8

  shadow-[0_8px_25px_rgba(0,0,0,0.08)]

  transition-all duration-500 ease-out

  hover:-translate-y-3 hover:scale-[1.04]

  hover:shadow-[0_20px_35px_rgba(0,0,0,0.15)]"

  data-aos="fade-up"
  data-aos-duration="800"
>

  <!-- Imagen -->

  <div class="shrink-0 flex items-center ml-1 md:ml-2 lg:ml-4">

    <img
      src={ambassador.image}
      alt={ambassador.name}
      class="
      w-[58px] h-[90px]
      md:w-[90px] md:h-[135px]
      lg:w-[120px] lg:h-[180px]
      object-cover
      rounded-[12px] md:rounded-[18px] lg:rounded-[22px]"
    />

  </div>


  <!-- Información -->

  <div
    class="
    flex-1
    flex
    flex-col
    h-full
    justify-start
    pt-2
    md:pt-6
    lg:pt-2
    min-w-0"
  >

    <h3
      class="
      text-[#3333FF]
      font-bold
      text-[8px]
      md:text-sm
      lg:text-xl
      leading-tight
      overflow-hidden"
    >
      {ambassador.name}
    </h3>


    <p
      class="
      text-[#3333FF]
      font-medium
      text-[6px]
      md:text-xs
      lg:text-sm
      mt-1
      leading-snug
      overflow-hidden"
    >
      {
        currentLanguage === "es"
          ? ambassador.position_es
          : ambassador.position_en
      }
    </p>


    <p
      class="
      text-black
      text-[6px]
      md:text-xs
      lg:text-sm
      mt-1
      leading-snug
      overflow-hidden"
    >
      {ambassador.company}
    </p>


    <button
      type="button"
      data-ambassador-id={ambassador.id}
      class="
      ambassador-button

      mt-auto

      w-fit

      px-2
      py-0.5

      md:px-4
      md:py-1

      lg:px-7
      lg:py-2

      rounded-full

      border border-[#ff0066]

      text-[#ff0066]

      text-[5px]
      md:text-xs
      lg:text-base

      font-bold

      transition-all duration-300

      hover:bg-[#ff0066]

      hover:text-white"
    >
      {t("ambassadors.read_more")}
    </button>

  </div>

</article>