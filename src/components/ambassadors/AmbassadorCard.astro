---
import i18next, { t } from "i18next";
const { ambassador } = Astro.props;
const currentLanguage = i18next.language;
---

<article
  class="group w-full min-h-[240px] rounded-[30px] border border-gray-200 bg-white p-6 flex items-center gap-8 shadow-[0_8px_25px_rgba(0,0,0,0.08)] transition-all duration-500 ease-out hover:-translate-y-4 hover:scale-[1.05] hover:shadow-[0_25px_45px_rgba(0,0,0,0.18)]"
  data-aos="fade-up"
  data-aos-duration="800"
>
  <!-- Imagen -->
  <div class="shrink-0 flex items-center">
    <img
      src={ambassador.image}
      alt={ambassador.name}
      class="w-[120px] h-[150px] object-cover rounded-[22px]"
    />
  </div>

  <!-- Información -->
  <div class="flex-1 flex flex-col py-2">
    <h3 class="text-[#3333FF] font-bold text-2xl leading-tight">
      {ambassador.name}
    </h3>

    <p class="text-[#3333FF] font-semibold text-lg mt-4 leading-snug">
      {
        currentLanguage === "es"
          ? ambassador.position_es
          : ambassador.position_en
      }
    </p>

    <p class="text-black text-lg mt-5 leading-snug">
      {ambassador.company}
    </p>

    <button
      type="button"
      data-ambassador-id={ambassador.id}
      class="ambassador-button mt-4 w-fit px-7 py-2 rounded-full border-2 border-[#ff0066] text-[#ff0066] font-bold transition-all duration-300 hover:bg-[#ff0066] hover:text-white"
    >
      {t("ambassadors.read_more")}
    </button>
    
  </div>
</article>