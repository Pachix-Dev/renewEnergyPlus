---
import i18next, { t } from "i18next";
const base = i18next.language === "es" ? "" : `/${i18next.language}`;
const currentLanguage = i18next.language;
---

<section class="relative w-full overflow-hidden bg-black sm:min-h-screen">
  <img
    src="/img/imagen2027/background_replus_2027.webp"
    alt="REPLUS MEXICO 2027 Background"
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover"
    loading="lazy"
  />
  <div class="absolute inset-0 bg-black/5"></div>
  <div
    class="relative z-10 flex flex-col sm:flex-row items-center justify-center gap-8 lg:gap-10 text-white text-center px-4 sm:px-8 lg:px-16 xl:px-24 py-10 sm:py-12 lg:min-h-screen"
    data-aos="fade-up"
    data-aos-duration="1000"
  >
    <div
      class="flex flex-col justify-center items-center gap-2 sm:gap-4 sm:w-2/3"
      data-aos="zoom-in"
      data-aos-duration="1100"
      data-aos-delay="100"
    >
      <img
        src="/img/imagen2027/slogan.webp"
        alt="REPLUS MEXICO 2027"
        class="w-full max-w-xs sm:max-w-xl h-auto"
        data-aos="fade-right"
        data-aos-duration="1000"
        data-aos-delay="200"
      />
      <img
        src={currentLanguage === "es"
          ? "/img/imagen2027/date_es_event_2027.webp"
          : "/img/imagen2027/date_en_event_2027.webp"}
        alt="Date Event"
        class="w-full max-w-[250px] sm:max-w-sm h-auto"
        data-aos="fade-left"
        data-aos-duration="1000"
        data-aos-delay="300"
      />
      <p
        class="text-center text-sm md:text-2xl tracking-wide leading-relaxed font-semibold uppercase max-w-xl mx-auto"
      >
        {t("home.slogan")}
      </p>
    </div>
    <div class="sm:w-1/3 bg-white/10 backdrop-blur-sm rounded-lg shadow-lg p-3 sm:p-5 flex flex-col gap-4">
      <p
        class="text-center lg:text-left text-base md:text-3xl tracking-wide leading-relaxed font-bold uppercase"
        data-aos="fade-up"
        data-aos-duration="1000"
        data-aos-delay="400"
      >
        {
          currentLanguage === "es"
            ? "Sé parte de la comunidad RE+ MEXICO 2027"
            : "Be part of the RE+ MEXICO 2027 community"
        }
      </p>
      <a
        href={`${base}/prerregistro`}
        rel="noopener noreferrer"
        class="hero-preregistro-btn inline-flex w-full rounded-2xl items-center justify-center gap-2 px-6 py-3 sm:px-8 sm:py-4 text-base sm:text-lg lg:text-xl font-extrabold text-black uppercase bg-yellow-400 hover:bg-[#FF0268] hover:text-white transition-colors duration-300 ease-in-out"
        >{currentLanguage === "es" ? "PRERREGÍSTRATE AQUÍ" : "PRE-REGISTER HERE"}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="21"
          height="24"
          viewBox="0 0 448 512"
          ><path
            fill="currentColor"
            d="m190.5 66.9l22.2-22.2c9.4-9.4 24.6-9.4 33.9 0L441 239c9.4 9.4 9.4 24.6 0 33.9L246.6 467.3c-9.4 9.4-24.6 9.4-33.9 0l-22.2-22.2c-9.5-9.5-9.3-25 .4-34.3L311.4 296H24c-13.3 0-24-10.7-24-24v-32c0-13.3 10.7-24 24-24h287.4L190.9 101.2c-9.8-9.3-10-24.8-.4-34.3"
          ></path></svg
        >
      </a>
    </div>
  </div>
</section>
