---
import i18next, { t, changeLanguage } from "i18next";
const currentLanguage = i18next.language;
---
<div class="grid gap-5">
  <section class="border border-dashed border-gray-300 bg-[#f7f7fa] p-5">
    <p
      class="text-sm font-extrabold uppercase tracking-[0.14em] text-[#565078]"
    >
      Banner publicitario
    </p>
  </section>

  <section class="border border-gray-200 bg-white p-5 shadow-sm">
    <h2 class="text-base font-extrabold text-[#565078]">Otras noticias</h2>
    <div class="mt-4 space-y-3">
      <div class="h-16 border border-dashed border-gray-300 bg-gray-50"></div>
      <div class="h-16 border border-dashed border-gray-300 bg-gray-50"></div>
      <div class="h-16 border border-dashed border-gray-300 bg-gray-50"></div>
    </div>
  </section>
</div>
