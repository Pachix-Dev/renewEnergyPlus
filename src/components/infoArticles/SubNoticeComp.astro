---
import i18next from "i18next";
const currentLanguage = i18next.language;
const baseUrl = currentLanguage === "es" ? "/expositor" : "/en/expositor";
---

<div class="flex justify-center">
  <a href={baseUrl} class="block w-full">
    <img
      src={currentLanguage === "es"
        ? "/img/banner_replus_es.webp"
        : "/img/banner_replus_en.webp"}
      alt="Re+ Conviertete en expositor"
      class="mx-auto h-[320px] max-h-[calc(100vh-6rem)] w-full object-contain sm:h-[480px] md:h-[560px] lg:h-[600px]"
    />
  </a>
</div>
