---
import i18next from "i18next";
const currentLanguage = i18next.language;
---

<div class="flex justify-center">
  <a href="" class="block w-full">
    <img
      src={currentLanguage === "es"
        ? "/img/banner_replus_es.webp"
        : "/img/banner_replus_en.webp"}
      alt="Re+ Conviertete en expositor"
      class="mx-auto h-[600px] max-h-[calc(100vh-7rem)] w-full object-contain"
    />
  </a>
</div>
