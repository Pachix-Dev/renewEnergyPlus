---
type LinkedInPost = {
  src: string;
  title: string;
  height?: number;
  mobileHeight?: number;
};

interface Props {
  posts?: LinkedInPost[];
}

const defaultPosts: LinkedInPost[] = [
  {
    src: "https://www.linkedin.com/embed/feed/update/urn:li:ugcPost:7495556214869663744?collapsed=1",
    title: "Publicacion integrada de LinkedIn",
    height: 480,
    mobileHeight: 320,
  }
];

const { posts = defaultPosts } = Astro.props;
---

<section class="py-8 md:py-10">
  <div class="grid grid-cols-1 gap-5 xl:grid-cols-2">
    {
      posts.map((post) => (
        <article
          class="mx-auto w-full max-w-[430px] border border-gray-200 bg-white p-2 shadow-sm sm:p-3"
          style={`--iframe-height: ${post.height ?? 480}px; --iframe-mobile-height: ${
            post.mobileHeight ?? 320
          }px;`}
        >
          <iframe
            src={post.src}
            height={post.height ?? 480}
            width="504"
            frameborder="0"
            allowfullscreen=""
            title={post.title}
            class="linkedin-post-iframe block w-full max-w-full"
          />
        </article>
      ))
    }
  </div>
</section>

<style>
  .linkedin-post-iframe {
    height: var(--iframe-mobile-height);
  }

  @media (min-width: 768px) {
    .linkedin-post-iframe {
      height: var(--iframe-height);
    }
  }
</style>
