---
import i18next, { t } from "i18next";
import { PrerregistroForm } from "./PrerregistroForm.jsx";

const formTranslations = t("preRegistro.form", { returnObjects: true });
const currentLanguage = i18next.language;

const eventDetails = [
  {
    label: currentLanguage === "es" ? "Ubicacion" : "Location",
    value:
      currentLanguage === "es"
        ? "Expo Guadalajara"
        : "Expo Guadalajara",
    icon: "location",
  },
  {
    label: currentLanguage === "es" ? "Fecha y Hora" : "Date and Time",
    value:
      currentLanguage === "es"
        ? "20 al 22 de abril, 2027"
        : "April 20-22, 2027",
    icon: "calendar",
  },
];
---

<section
  class="relative flex min-h-[calc(100svh-80px)] w-full items-center justify-center overflow-hidden bg-[url('/img/bg_replus_v2.webp')] bg-cover bg-center bg-no-repeat px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12"
>
  <div class="absolute inset-0 bg-black/40"></div>
  <div
    class="relative z-10 grid w-full max-w-7xl grid-cols-1 items-center gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(360px,480px)] lg:gap-10 xl:gap-14"
  >
    <div class="flex min-w-0 flex-col items-center gap-5 text-center lg:items-start lg:text-left">
      <div
        class="flex w-full flex-col items-start gap-5 sm:justify-center lg:justify-between"
      >
        <div
          class="w-full min-w-0 sm:w-auto"
          data-aos="fade-right"
          data-aos-duration="900"
        >
          <img src="/img/imagen2027/slogan.webp" alt="" class="w-auto sm:w-[600px]">
        </div>
        <div
          class="w-full min-w-0 text-center sm:w-auto sm:text-left"
          data-aos="fade-up"
          data-aos-duration="850"
          data-aos-delay="120"
        >
          <h1
            class="text-2xl font-bold uppercase leading-tight text-white sm:text-3xl md:text-4xl xl:text-5xl"
          >
            RE+ MEXICO 2027
          </h1>
        </div>
      </div>
      <div
        class="w-full"
        data-aos="fade-up"
        data-aos-duration="900"
        data-aos-delay="180"
      >
        <p
          class="title-hero font-light mx-auto h-auto max-w-3xl px-1 text-center text-base uppercase leading-relaxed text-white sm:px-0 sm:text-lg md:text-xl lg:mx-0 lg:text-left xl:text-2xl"
        >
          {
            currentLanguage === "es"
              ? "La feria B2B líder en energías renovables y eficiencia energética"
              : "The leading B2B fair in renewable energy and energy efficiency"
          }
        </p>
      </div>
      <div
        class="mt-1 flex w-full max-w-lg gap-3 sm:mt-2 sm:max-w-xl sm:flex-row sm:justify-center sm:gap-6 lg:justify-start"
        data-aos="fade-up"
        data-aos-duration="900"
        data-aos-delay="240"
      >
        {
          eventDetails.map((item) => (
            <div class="flex min-w-0 items-center justify-start gap-2 text-left sm:justify-center sm:gap-3">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-black/35 text-white ring-1 ring-white/50 sm:h-12 sm:w-12">
                {item.icon === "location" ? (
                  <svg
                    class="h-4 w-4 sm:h-6 sm:w-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                ) : (
                  <svg
                    class="h-4 w-4 sm:h-6 sm:w-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M8 2v4" />
                    <path d="M16 2v4" />
                    <rect width="18" height="18" x="3" y="4" rx="2" />
                    <path d="M3 10h18" />
                  </svg>
                )}
              </span>
              <div class="min-w-0">
                <p class="text-xs font-light leading-4 text-white sm:text-sm sm:leading-5">
                  {item.label}
                </p>
                <p class="text-xs font-semibold leading-5 text-white sm:text-lg sm:leading-6">
                  {item.value}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <div class="flex w-full justify-center lg:justify-end">
      <PrerregistroForm
        translates={formTranslations}
        currentLanguage={currentLanguage}
        client:only="react"
      />
    </div>
  </div>
</section>
<style>
  @font-face {
    font-family: "Montserrat-Italic-VariableFont_wght";
    src: url("/fonts/Montserrat-Italic-VariableFont_wght.ttf") format("truetype");
    font-display: swap;
    font-weight: normal;
    font-style: italic;
  }

  @font-face {
    font-family: "Montserrat-VariableFont_wght";
    src: url("/fonts/Montserrat-VariableFont_wght.ttf") format("opentype");
    font-display: swap;
    font-weight: normal;
    font-style: normal;
  }

  .title-hero {
    font-family: "Montserrat-Italic-VariableFont_wght", "Arial", sans-serif;
  }
  .text-desc {
    font-family: "Montserrat-VariableFont_wght", "Arial", sans-serif;
    letter-spacing: clamp(1.2px, 0.4vw, 6px);
  }
</style>
