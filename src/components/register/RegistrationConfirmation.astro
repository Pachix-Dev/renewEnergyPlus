---
import { t } from "i18next";
import { DonwloadAccess } from "./DonwloadAccess.jsx";

interface Props {
  base: string;
}

const { base } = Astro.props;
const headingClass = "text-xl font-bold leading-6 lg:text-[clamp(1.35rem,2vw,1.8rem)] lg:leading-[1.2]";
const focusClass = "focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-4 focus-visible:outline-[#003366]";
const visitLinkClass = `flex min-h-12 items-center justify-center rounded-[0.3rem] border border-[#ff3a92] px-3 py-2 text-sm font-bold uppercase leading-5 transition-colors duration-150 hover:bg-[#003366] hover:text-white motion-reduce:transition-none lg:min-h-[2.9rem] lg:py-[0.6rem] lg:text-[clamp(0.85rem,1.39vw,1.25rem)] lg:leading-tight ${focusClass}`;
const socialLinkClass = `flex size-12 items-center justify-center rounded-full bg-[#657d94] text-white transition-colors duration-150 hover:bg-[#003366] motion-reduce:transition-none lg:size-11 ${focusClass}`;
const socialLinks = [
  {
    name: "Instagram",
    href: "https://www.instagram.com/replusmexico/",
    path: "M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm5 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6ZM7 4a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm10.5 1.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z",
  },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/company/solarstoragemexico/",
    path: "M6.5 8.5H3V21h3.5V8.5ZM4.75 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM21 13.8c0-3.8-2-5.6-4.7-5.6-2.1 0-3 1.1-3.5 1.9V8.5H9.3V21h3.5v-6.2c0-1.6.3-3.1 2.3-3.1s2 1.8 2 3.2V21H21v-7.2Z",
  },
  {
    name: "Facebook",
    href: "https://www.facebook.com/REPlusMexico",
    path: "M14 22v-9h3l.5-4H14V6.5c0-1.2.3-2 2-2h2V1.2A25 25 0 0 0 15 1c-3 0-5 1.8-5 5v3H7v4h3v9h4Z",
  },
];
---

<main
  class="bg-[#00264d] bg-[linear-gradient(115deg,rgba(0,16,69,0.65),rgba(0,26,49,0.72)),url('/img/imagen2027/background_hero_2027.webp')] bg-cover bg-center px-4 py-6 text-white sm:px-6 lg:min-h-[47.4375rem] lg:px-[clamp(1rem,6.1vw,5.5rem)] "
  aria-labelledby="registration-title"
>
  <div class="mx-auto grid w-full max-w-[40rem] items-start gap-6 lg:max-w-[79rem] lg:grid-cols-[minmax(0,1fr)_minmax(0,1.215fr)] lg:gap-[clamp(2.5rem,6.5vw,5.875rem)]">
    <div class="min-w-0 text-center lg:text-left">
      <h1
        id="registration-title"
        class="m-0 mx-auto max-w-[15ch] text-[2rem] font-extrabold uppercase leading-8 [overflow-wrap:anywhere] lg:mx-0 lg:max-w-none lg:text-[clamp(2.15rem,4.28vw,3.85rem)] lg:leading-[0.92]"
      >{t("thanks_page.registration.title")}</h1>
      <p class="mt-3 text-xl font-bold uppercase leading-6 text-[#66ffff] lg:mt-7 lg:text-[clamp(1.65rem,2.64vw,2.375rem)] lg:leading-none">
        {t("thanks_page.registration.welcome")}<br />
        <span>{t("thanks_page.registration.event_name")}</span>
      </p>
      <p class="mt-4 text-base font-medium leading-6 lg:mt-10 lg:text-[clamp(1rem,1.53vw,1.375rem)] lg:leading-[1.2]">{t("thanks_page.registration.description")}</p>
      <p class="mt-4 grid text-lg font-extrabold leading-6 lg:mt-8 lg:gap-[0.15rem] lg:text-[clamp(1.35rem,1.95vw,1.75rem)] lg:leading-[1.2]">
        <time datetime="2027-04-20" class="uppercase">{t("thanks_page.registration.dates")}</time>
        <span>{t("thanks_page.registration.venue")}</span>
      </p>
      <p class="mt-3 text-sm font-medium leading-5 lg:mt-7 lg:text-[clamp(1rem,1.53vw,1.375rem)] lg:leading-[1.2]">{t("thanks_page.registration.email_notice")}</p>
    </div>

    <section
      class="min-w-0 rounded-2xl border-2 border-transparent [background:linear-gradient(#e6e6e6,#e6e6e6)_padding-box,linear-gradient(35deg,#00cccc,#3333ff_55%)_border-box] p-4 text-center text-[#003366] lg:rounded-[1.25rem] lg:border-[5px] lg:px-[clamp(1rem,4.7vw,4.25rem)] lg:pb-4 lg:pt-[clamp(1.5rem,3.2vw,3rem)]"
      aria-labelledby="access-title"
    >
      <h2 id="access-title" class={headingClass}>{t("thanks_page.registration.access_title")}</h2>
      <DonwloadAccess
        client:only="react"
        text={t("thanks_page.registration.download_qr")}
        variant="registration"
        fallbackHref={`${base}/reimprimir-gafete`}
      />
      <p class="mt-3 text-sm font-medium leading-5 lg:-mx-[0.4rem] lg:mt-[1.9rem] lg:text-[clamp(1rem,1.51vw,1.36rem)] lg:leading-[1.4]">{t("thanks_page.registration.access_description")}</p>

      <div class="mt-4 border-t border-[#98aabc] pt-4 lg:mt-8 lg:pt-[1.85rem]">
        <h2 id="visit-title" class={`${headingClass} uppercase`}>{t("thanks_page.registration.visit_title")}</h2>
        <nav class="mx-auto mt-3 grid max-w-[26.75rem] gap-2 lg:mt-[1.15rem] lg:gap-[0.9rem]" aria-labelledby="visit-title">
          <a href={`${base}/plano-re-plus-mexico-2027`} class={visitLinkClass}>
            {t("thanks_page.registration.exhibitors")}
          </a>
          <a href={`${base}/programa-premium`} class={visitLinkClass}>
            {t("thanks_page.registration.premium_program")}
          </a>
        </nav>
      </div>

      <div class="mt-4 text-sm font-medium leading-5 lg:mt-[1.85rem] lg:text-[clamp(1rem,1.39vw,1.25rem)] lg:leading-[1.4]">
        <p id="registration-social-title">{t("thanks_page.registration.social_title")}</p>
        <ul class="mt-2 flex list-none justify-center gap-2 p-0 lg:mt-[0.9rem] lg:gap-[0.9rem]" aria-labelledby="registration-social-title">
          {
            socialLinks.map(({ name, href, path }) => (
              <li>
                <a href={href} target="_blank" rel="noopener noreferrer" aria-label={name} class={socialLinkClass}>
                  <svg class="size-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={path} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</main>

