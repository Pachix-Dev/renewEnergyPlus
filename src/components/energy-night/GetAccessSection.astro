---
import i18next, { t } from "i18next";
const currentLanguage = i18next.language;
const base = currentLanguage === "es" ? "" : `/${currentLanguage}`;
---

<section
  data-aos="fade-up"
  data-aos-duration="1000"
  data-aos-anchor-placement="top-bottom"
>
  <div
    class="bg-[url(/img/energyNigth_2027/bg_get_access.webp)] sm:min-h-[520px] px-5 py-4 sm:py-12 gap-6 text-center bg-cover bg-center flex flex-col items-center justify-center text-white"
  >
    <img
      src="/img/energyNigth_2027/energy_nightlogo.webp"
      alt="energy night 2027"
      class="w-[200px] h-auto sm:w-[400px]"
      data-aos="zoom-in"
      data-aos-duration="900"
      data-aos-delay="120"
    />
    <h2
      class="font-aton-regular max-w-5xl text-2xl leading-none sm:text-[80px] sm:leading-none"
      data-aos="fade-up"
      data-aos-duration="900"
      data-aos-delay="220"
    >
      {t("energynight.text_30")}
    </h2>
    <p
      class="max-w-3xl text-sm sm:text-xl bg-[#003366] px-8 py-4 rounded-full border-4 border-white"
      data-aos="fade-up"
      data-aos-duration="900"
      data-aos-delay="320"
      set:html={t("energynight.text_25")}
    />
  </div>
</section>
<section>
    <div class="sm:w-[1100px] mx-auto sm:p-10">
        <lite-youtube videoid="JddYgCXIsqY" videotitle="Energy Night 2027"></lite-youtube>
    </div>
</section>
<section class="text-white">
    <div class="text-center bg-[#3333ff] py-2 sm:py-8">
        <h2 class="font-aton-regular text-4xl sm:text-[80px] p-2">{t("energynight.text_31")}</h2>
    </div>
    <div class="text-center bg-[url(/img/energyNigth_2027/bg_info_energy_night.webp)] bg-cover bg-center">
        <p class="font-montserrat-italic py-2 sm:py-8 text-base sm:text-3xl max-w-7xl mx-auto p-2">{t("energynight.text_32")}</p>
    </div>
</section>
<script>
    import '@justinribeiro/lite-youtube';
</script>
<style>
  @font-face {
    font-family: "Aton";
    src: url("/fonts/Anton-Regular.ttf") format("woff2");
    font-weight: normal;
    font-style: normal;
  }

  @font-face {
    font-family: "Montserrat Regular";
    src: url("/fonts/Montserrat-VariableFont_wght.ttf") format("woff2");
    font-weight: normal;
    font-style: normal;
  }

  
  @font-face {
    font-family: "Montserrat Italic";
    src: url("/fonts/Montserrat-Italic-VariableFont_wght.ttf") format("woff2");
    font-weight: normal;
    font-style: normal;
  }

  .font-montserrat-regular {
    font-family: "Montserrat Regular", sans-serif;
  }

  .font-aton-regular {
    font-family: "Aton", sans-serif;
  }
  .font-montserrat-italic {
    font-family: "Montserrat Italic", sans-serif;
  }
</style>
