---
import i18next, { t } from "i18next";
const currentLanguage = i18next.language;
const base = currentLanguage === "es" ? "" : `/${currentLanguage}`;
---

<section
  data-aos="fade-up"
  data-aos-duration="1000"
  data-aos-anchor-placement="top-bottom"
>
  <div
    class="bg-[url(/img/energyNigth_2027/bg_get_access.webp)] sm:min-h-[520px] px-5 py-4 sm:py-12 gap-6 text-center bg-cover bg-center flex flex-col items-center justify-center text-white"
  >
    <img
      src="/img/energyNigth_2027/energy_nightlogo.webp"
      alt="energy night 2027"
      class="w-[200px] h-auto sm:w-[400px]"
      data-aos="zoom-in"
      data-aos-duration="900"
      data-aos-delay="120"
    />
    <h2
      class="font-aton-regular max-w-5xl text-2xl leading-none sm:text-[80px] sm:leading-none"
      data-aos="fade-up"
      data-aos-duration="900"
      data-aos-delay="220"
    >
      {t("energynight.text_30")}
    </h2>
    <p
      class="max-w-3xl text-sm sm:text-xl bg-[#003366] px-8 py-4 rounded-full border-4 border-white"
      data-aos="fade-up"
      data-aos-duration="900"
      data-aos-delay="320"
      set:html={t("energynight.text_25")}
    />
  </div>
</section>
<style>
  @font-face {
    font-family: "Aton";
    src: url("/fonts/Anton-Regular.ttf") format("woff2");
    font-weight: normal;
    font-style: normal;
  }

  @font-face {
    font-family: "Montserrat Regular";
    src: url("/fonts/Montserrat-VariableFont_wght.ttf") format("woff2");
    font-weight: normal;
    font-style: normal;
  }

  .font-montserrat-regular {
    font-family: "Montserrat Regular", sans-serif;
  }

  .font-aton-regular {
    font-family: "Aton", sans-serif;
  }
</style>
